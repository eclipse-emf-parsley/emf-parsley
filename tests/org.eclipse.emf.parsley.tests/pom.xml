<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<relativePath>../../releng/org.eclipse.emf.parsley.parent/pom.xml</relativePath>
		<groupId>org.eclipse.emf.parsley</groupId>
		<artifactId>org.eclipse.emf.parsley.parent</artifactId>
		<version>1.18.0-SNAPSHOT</version>
	</parent>

	<artifactId>org.eclipse.emf.parsley.tests</artifactId>
	<packaging>eclipse-test-plugin</packaging>

	<properties>
		<!-- Workaround for https://bugs.eclipse.org/bugs/show_bug.cgi?id=397015 -->
		<sonar.sources></sonar.sources>
		<sonar.tests>src</sonar.tests>

		<!-- To make it work with Java 25 until we update ByeBuddy -->
		<systemProperties>-Dnet.bytebuddy.experimental=true</systemProperties>

		<!-- Defaults to 4000 -->
		<pit-timeout-const>1000</pit-timeout-const>
	</properties>

	<dependencies>
		<dependency>
			<!-- needed for running plain Junit tests with Maven surefire plugin -->
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>org.eclipse.emf.parsley.examples.library</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>org.eclipse.emf.parsley.tests.models</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>org.eclipse.emf.parsley.junit4</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<!-- Since these are plain Junit tests, we use maven surefire instead
					of tycho surefire -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<executions>
					<execution>
						<!-- The execution id default-test must be left to tycho-surefire-plugin 
							since it will execute it anyway -->
						<id>MavenSurefirePluginTest</id>
						<phase>test</phase>
						<configuration>
							<skip>${simple.tests.skip}</skip>
							<testClassesDirectory>${project.build.outputDirectory}</testClassesDirectory>
							<includes>
								<include>**/*Test.java</include>
								<include>**/*Scenario.java</include>
							</includes>
							<excludes>
								<exclude>**/*Abstract*Test.java</exclude>
								<exclude>**/*Activator.java</exclude>
							</excludes>
						</configuration>
						<goals>
							<goal>test</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-surefire-plugin</artifactId>
				<executions>
					<execution>
						<id>default-test</id>
						<phase>none</phase>
						<goals>
							<goal>plugin-test</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>mutation-testing</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<version>${pitest.version}</version>
						<configuration>
							<timeoutConstant>${pit-timeout-const}</timeoutConstant>
							<crossModule>true</crossModule>

							<targetClasses>
								<param>org.eclipse.emf.parsley.*</param>
							</targetClasses>

							<excludedClasses>
								<!-- Explicitly excluded: classes in the top-level package only -->
								<param>org.eclipse.emf.parsley.EmfParsleyActivator*</param>
								<param>org.eclipse.emf.parsley.EmfParsleyExtensionFactory*</param>
								<param>org.eclipse.emf.parsley.EmfParsleyGuiceModule*</param>
								<param>org.eclipse.emf.parsley.EmfParsleyJavaGuiceModule*</param>

								<!-- Individual classes having 0% line coverage -->
								<param>org.eclipse.emf.parsley.composite.FormDetailReadOnlyComposite*</param>
								<param>org.eclipse.emf.parsley.composite.TableFormComposite*</param>
								<param>org.eclipse.emf.parsley.composite.TableFormFactory*</param>
								
								<param>org.eclipse.emf.parsley.edit.EditCommand*</param>
								<param>org.eclipse.emf.parsley.edit.OnTheFlyEditingStrategy*</param>
								<param>org.eclipse.emf.parsley.edit.UndoableEditingStrategy*</param>
								
								<param>org.eclipse.emf.parsley.edit.action.EditingActionManager*</param>
								
								<param>org.eclipse.emf.parsley.listeners.OpenDialogMouseAdapter*</param>
								<param>org.eclipse.emf.parsley.listeners.OpenFormBasedDialogMouseAdapter*</param>
								<param>org.eclipse.emf.parsley.listeners.OpenPropertyViewMouseAdapter*</param>
								
								<param>org.eclipse.emf.parsley.util.ActionBarsUtils*</param>
								<param>org.eclipse.emf.parsley.util.EmfParsleyUiUtil*</param>
								
								<param>org.eclipse.emf.parsley.validation.DialogErrorReporter*</param>
								
								<param>org.eclipse.emf.parsley.viewers.TableViewerEditableColumnBuilder*</param>
								<param>org.eclipse.emf.parsley.viewers.TableViewerEditingSupportFactory*</param>
								<param>org.eclipse.emf.parsley.viewers.ViewerSelectionProvider*</param>

								<!-- Explicitly excluded packages -->
								<param>org.eclipse.emf.parsley.internal.edit.ui.dnd.*</param>
								<param>org.eclipse.emf.parsley.runtime.*</param>

								<!-- Packages having 0% line coverage -->
								<param>org.eclipse.emf.parsley.dialogs.*</param>
								<param>org.eclipse.emf.parsley.edit.actionbar.*</param>
								<param>org.eclipse.emf.parsley.edit.ui.dnd.*</param>
								<param>org.eclipse.emf.parsley.handlers.*</param>
								<param>org.eclipse.emf.parsley.menus.*</param>

								<!-- org.eclipse.emf.parsley.ui itself, but NOT
								ui.provider -->
								<param>org.eclipse.emf.parsley.ui.EmfParsleyAbstractActivator*</param>

								<param>org.eclipse.emf.parsley.tests.*</param>
								<param>org.eclipse.emf.parsley.examples.*</param>
								<param>org.eclipse.emf.parsley.junit4.*</param>
							</excludedClasses>

							<targetTests>
								<param>org.eclipse.emf.parsley.tests.*</param>
							</targetTests>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>