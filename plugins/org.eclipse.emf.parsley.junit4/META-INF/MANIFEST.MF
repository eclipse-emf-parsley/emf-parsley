 org.junit.runner;version="4.5.0",
 org.junit.runner.manipulation;version="4.5.0",
 org.junit.runner.notification;version="4.5.0",
 org.junit.runners;version="4.5.0",
 org.junit.runners.model;version="4.5.0"
Require-Bundle: org.eclipse.jface.databinding;visibility:=reexport,
 org.eclipse.jface;visibility:=reexport,
 org.eclipse.core.databinding.observable;visibility:=reexport,
 org.eclipse.emf.ecore;visibility:=reexport
Automatic-Module-Name: org.eclipse.emf.parsley.junit4
