<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>

<product name="EMF Parsley Mail RCP Product" uid="org.eclipse.emf.parsley.examples.mail.rcp.product" id="org.eclipse.emf.parsley.examples.mail.rcp.product" application="org.eclipse.emf.parsley.examples.mail.rcp.application" version="1.19.0.qualifier" useFeatures="false" includeLaunchers="true">

   <aboutInfo>
      <image path="product_lg.gif"/>
      <text>
         RCP Mail template created by PDE
      </text>
   </aboutInfo>

   <configIni use="default">
   </configIni>

   <launcherArgs>
      <vmArgs>-Xms40m -Xmx512m</vmArgs>
      <vmArgsMac>-XstartOnFirstThread</vmArgsMac>
   </launcherArgs>

   <windowImages i16="icons/sample2.gif"/>

   <splash
      location="org.eclipse.emf.parsley.examples.mail.rcp" />
   <launcher name="emfparsley_mail">
      <solaris/>
      <win useIco="false">
         <bmp/>
      </win>
   </launcher>

   <vm>
   </vm>

   <plugins>
      <plugin id="org.eclipse.equinox.launcher"/>
      <plugin id="org.eclipse.osgi"/>
      <plugin id="org.eclipse.equinox.app"/>
      <plugin id="org.eclipse.core.runtime"/>
      <plugin id="org.eclipse.ui"/>
      <plugin id="org.eclipse.swt"/>
      <plugin id="org.eclipse.emf.parsley.examples.mail.rcp"/>
      <plugin id="org.eclipse.ui.forms"/>
      <plugin id="org.eclipse.emf.parsley.examples.mail.model"/>
      <plugin id="org.eclipse.emf.parsley.views.common"/>
      <plugin id="org.eclipse.emf.parsley.common"/>
      <plugin id="org.eclipse.emf.parsley.views"/>
      <plugin id="org.eclipse.xtext.xbase.lib"/>
      <plugin id="com.google.guava"/>
      <plugin id="org.eclipse.emf.parsley"/>
      <plugin id="org.eclipse.ui.views"/>
      <plugin id="org.eclipse.emf.parsley.runtime"/>
      <plugin id="org.eclipse.emf.parsley.runtime.common"/>
      <plugin id="org.eclipse.emf.databinding.edit"/>
      <plugin id="org.apache.log4j"/>
      <plugin id="org.eclipse.core.resources"/>
      <plugin id="org.eclipse.emf.ecore.edit"/>
      <plugin id="org.eclipse.emf.edit.ui"/>
      <plugin id="org.eclipse.core.filesystem"/>
      <plugin id="org.eclipse.emf.edit"/>
      <plugin id="org.eclipse.emf.common.ui"/>
      <plugin id="com.google.inject"/>
      <plugin id="org.eclipse.emf.databinding"/>
